# Application
FASTDPS_SECRET=replace-with-a-long-random-value
FASTDPS_PORT=5024
FASTDPS_PUBLIC_URL=http://localhost:5024
FASTDPS_ENV_LABEL=Local
FASTDPS_DATA_DIR=./data
FASTDPS_DB=./data/fastdps.sqlite
FASTDPS_ALLOW_TEST_AUTH=true

# PostgreSQL (leave empty to use SQLite)
DB_URL=
# Production fleet alias; DB_URL takes precedence when both are set.
DATABASE_URL_PROD=
DB_SCHEMA=fast_dps
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=3
FASTDPS_TEST_POSTGRES_URL=

# Bootstrap platform administration. Comma-separated email addresses.
FASTDPS_PLATFORM_ADMINS=

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5024/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# Optional OpenAI-compatible chat provider
LLM_API_KEY=
# XAI_API_KEY is accepted as a fleet-compatible fallback for LLM_API_KEY.
XAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Optional XML converter. Install with: pip install -e '.[ocds-converter]'
FASTDPS_OCID_PREFIX=ocds-fastdps
